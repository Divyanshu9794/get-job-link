rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own user activity
    match /userActivity/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Jobs: allow authenticated users to read all, write for admins (email-based)
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "sdivyanshu352@gmail.com";
    }

    // Source config: allow admin write, read for all authenticated
    match /source_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "sdivyanshu352@gmail.com";
    }

    // Company priority: allow admin write, read for all authenticated
    match /company_priority/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "sdivyanshu352@gmail.com";
    }

    // Learning reels: allow admin write, read for all authenticated
    match /learning_reels/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "sdivyanshu352@gmail.com";
    }

    // Analytics: allow admin write, read for all authenticated
    match /analytics/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "sdivyanshu352@gmail.com";
    }
  }
}