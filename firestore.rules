rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "sdivyanshu352@gmail.com" ||
        request.auth.token.email == "getjoblink647@gmail.com"
      );
    }

    // 1. Public Jobs Collection
    // Anyone can read and browse published listings; write operations restricted to admin
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // 2. User Profiles and Subcollections
    match /users/{userId} {
      // User profile document: private to account owner and admin
      allow read, write: if isOwner(userId) || isAdmin();
      
      // Saved Jobs: users/{userId}/savedJobs/{jobId}
      match /savedJobs/{jobId} {
        // Only the authenticated account owner (or admin) can read their own saved jobs
        allow read: if isOwner(userId) || isAdmin();
        
        // Owner can save under their own UID, ensuring document data.userId matches auth UID
        allow create, update: if isOwner(userId)
          && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == userId);
        
        // Owner can delete / unsave their own saved jobs
        allow delete: if isOwner(userId) || isAdmin();
      }
      
      // ATS Evaluation History
      match /atsHistory/{evalId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      // Resume Metadata
      match /resumes/{resumeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Smart Job Alerts: users/{userId}/alerts/{alertId}
      match /alerts/{alertId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Career Preferences: users/{userId}/preferences/{prefId}
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Professional Passport: users/{userId}/passport/{passportId}
      match /passport/{passportId} {
        // Public read if passport.isPublic == true; full access for owner and admin
        allow read: if resource.data.isPublic == true || isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Project Proof Items: users/{userId}/projects/{projectId}
      match /projects/{projectId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }

      // Career Missions & Streaks: users/{userId}/missions/{missionId}
      match /missions/{missionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 3. Public Professional Passports (Index Collection for quick vanity URL lookup)
    match /public_passports/{passportHandle} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 4. Anonymous Job Seekers Community Posts & Comments
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content.size() <= 4000;
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.content.size() <= 2000;
        allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      }
    }

    // 5. Community Moderation Reports
    match /community_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // 6. Curated & Dynamic Job Bundles / Collections
    match /job_collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Daily Job Drops Archive
    match /daily_drops/{dropDate} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Company Follows: company_follows/{followId}
    match /company_follows/{followId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 9. Reports & Feedback (Public create, Admin read/manage)
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 10. Contact Us Inquiries (Public create, Admin read/manage)
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 11. User Platform Feedback (Authenticated users create only, Admin read/manage)
    match /feedbacks/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 12. Hiring Radar Aggregates (Public read, Admin update/write)
    match /hiring_radar_metadata/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Company Hiring Intelligence Profiles (Public read, Admin update/write)
    match /company_analytics/{companySlug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 14. Weekly Tech Jobs Digest Subscribers (Public opt-in, Admin read/manage)
    match /newsletter_subscribers/{subscriberId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    // 15. Admin Job Staging & Auto-Fetch Queue (Admin only)
    match /staging_jobs/{stagingJobId} {
      allow read, write: if isAdmin();
    }
  }
}
